# Application Environment (production | development | simulation)
APP_ENV=production

# FastAPI Server Port & Binding
PORT=8000
HOST=0.0.0.0

# Gemini API & Google Cloud Credentials
# Set your Gemini API key to activate live LLM inference mode
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# OpenTelemetry Exporter Endpoint (GCP Operations Suite or OTLP Collector)
# Example for local OTLP Collector: http://otel-collector:4317
# Example for GCP Operations Collector: gcp-otel-collector.monitoring:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-platform-observability
